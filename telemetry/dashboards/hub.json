{
  "uid": "sportal-hub",
  "title": "Hub",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "Game Day",
      "type": "link",
      "url": "/d/sportal-game-day/game-day?from=${__from}&to=${__to}&refresh=10s",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 12,
      "type": "row",
      "title": "Live feed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "logs",
      "title": "FastCast logs",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} |= \"FastCast\""
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "Poll",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 41,
      "type": "logs",
      "title": "Provider logs",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} |~ \"EspnProvider|EspnState\""
        }
      ]
    },
    {
      "id": 42,
      "type": "row",
      "title": "Hub",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 1,
          "type": "timeseries",
          "title": "Hub log volume by level",
          "gridPos": {
            "x": 0,
            "y": 29,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "bars",
                "fillOpacity": 80,
                "stacking": {
                  "mode": "normal"
                }
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (detected_level) (count_over_time({service_name=\"sportal-hub\"} [$__interval]))",
              "legendFormat": "{{detected_level}}"
            }
          ]
        },
        {
          "id": 2,
          "type": "logs",
          "title": "Recent warnings and errors",
          "gridPos": {
            "x": 12,
            "y": 29,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "{service_name=\"sportal-hub\"} | detected_level=~\"warn|error|fatal|critical\""
            }
          ]
        }
      ]
    }
  ]
}
