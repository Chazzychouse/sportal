{
  "uid": "sportal-hub",
  "title": "Hub",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(target_info{service_name=\"sportal-hub\"}, sportal_mode)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "game",
        "label": "Game",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "description": "A game id, or a pattern of them. Loki keeps game as structured metadata, not a label, so it has no list of values."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Hub log volume by level",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detected_level) (count_over_time({service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" [$__interval]))",
          "legendFormat": "{{detected_level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Recent warnings and errors",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" | detected_level=~\"warn|error|fatal|critical\""
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Poll duration",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sportal_poll_duration_milliseconds_bucket[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sportal_poll_duration_milliseconds_bucket[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Provider errors by league",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (league) (increase(sportal_provider_errors_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{league}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Poll traces",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"sportal-hub\" && resource.sportal.mode=\"$mode\" && name=\"Ingest.poll\"}",
          "limit": 20
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Game actors",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Live games by state",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (sportal_live_games_ratio * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Snapshots taken and behind",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, source) (increase(sportal_snapshots_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{source}} {{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Game actor defects",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(sportal_game_defects_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}) or vector(0)",
          "legendFormat": "defects"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Receive latency",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sportal_receive_duration_milliseconds_bucket[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sportal_receive_duration_milliseconds_bucket[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Transitions of $game",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Ascending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" | game=~\"$game\" |= \"→\""
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Live feed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Connected",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No"
                },
                "1": {
                  "text": "Yes"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sportal_live_feed_connected * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "connected"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Messages by league and op",
      "gridPos": {
        "x": 6,
        "y": 52,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (league, op) (increase(sportal_live_feed_messages_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{league}} {{op}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Errors by reason",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(sportal_live_feed_errors_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Games pushed, unlisted, and undecoded by league",
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (league) (increase(sportal_live_feed_games_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "pushed {{league}}"
        },
        {
          "refId": "B",
          "expr": "sum by (league) (increase(sportal_live_feed_unlisted_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "unlisted {{league}}"
        },
        {
          "refId": "C",
          "expr": "sum by (league) (increase(sportal_live_feed_undecoded_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "undecoded {{league}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Live feed logs",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" |~ \"FastCast|Ingest: the live feed\""
        }
      ]
    }
  ]
}
