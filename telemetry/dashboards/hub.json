{
  "uid": "sportal-hub",
  "title": "Hub",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "links": [],
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(target_info{service_name=\"sportal-hub\"}, sportal_mode)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Games",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every game the slate has listed, with its progress now: 0 once no listing names it.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (game, league, matchup) (sportal_game_state_ratio * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "matchup": 0,
              "league": 1,
              "Value": 2,
              "game": 3
            },
            "renameByName": {
              "Value": "State",
              "matchup": "Matchup",
              "league": "League",
              "game": "Game id"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "State",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Delisted",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "Upcoming",
                        "color": "blue",
                        "index": 1
                      },
                      "2": {
                        "text": "Live",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "Over",
                        "color": "purple",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Hub log volume by level",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detected_level) (count_over_time({service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" [$__interval]))",
          "legendFormat": "{{detected_level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Recent warnings and errors",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" | detected_level=~\"warn|error|fatal|critical\""
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Poll duration",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sportal_poll_duration_milliseconds_bucket[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sportal_poll_duration_milliseconds_bucket[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Provider errors by league",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (league) (increase(sportal_provider_errors_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{league}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Poll traces",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"sportal-hub\" && resource.sportal.mode=\"$mode\" && name=\"EspnProvider.pollEveryLeague\"}",
          "limit": 20
        }
      ]
    },
    {
      "id": 26,
      "type": "table",
      "title": "Take traces",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"sportal-hub\" && resource.sportal.mode=\"$mode\" && name=\"Director.take\"}",
          "limit": 20
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Live feed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Connected",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No"
                },
                "1": {
                  "text": "Yes"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sportal_live_feed_connected_ratio * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "connected"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Errors by reason",
      "gridPos": {
        "x": 6,
        "y": 43,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(sportal_live_feed_errors_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Checkpoint failures",
      "gridPos": {
        "x": 15,
        "y": 43,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(sportal_live_feed_checkpoint_failures_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}) or vector(0)",
          "legendFormat": "checkpoint failures"
        }
      ],
      "description": "Checkpoints that did not load or decode; each topic is tried again every 30 s, five tries in all, then left to polling. A lost document is a FastCast Warning in Live feed logs."
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Connects in range",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sportal_live_feed_connects_total[$__range]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}) or vector(0)",
          "legendFormat": "connects"
        }
      ]
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Live feed logs",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" |~ \"FastCast|EspnProvider|EspnDecoder|Director: the provider's frames\""
        }
      ]
    }
  ]
}
