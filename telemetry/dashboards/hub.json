{
  "uid": "sportal-hub",
  "title": "Hub",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "links": [],
  "templating": {
    "list": [
      {
        "name": "matchup",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(sportal_game_state_ratio, matchup)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(sportal_game_state_ratio, matchup)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Games",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every game the slate has listed, with its progress now: a game no listing names drops out (its series is removed).",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (game, league, matchup) (sportal_game_state_ratio)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "matchup": 0,
              "league": 1,
              "Value": 2,
              "game": 3
            },
            "renameByName": {
              "Value": "State",
              "matchup": "Matchup",
              "league": "League",
              "game": "Game id"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "State",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Upcoming",
                        "color": "blue",
                        "index": 1
                      },
                      "2": {
                        "text": "Live",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "Over",
                        "color": "purple",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 50,
      "type": "row",
      "title": "Plays",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 51,
      "type": "logs",
      "title": "Plays",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | play=~\".+\" | matchup=~\"$matchup\""
        }
      ]
    },
    {
      "id": 52,
      "type": "logs",
      "title": "Scoring plays",
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | play=~\".+\" | matchup=~\"$matchup\" | scoring=\"true\""
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Live feed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "logs",
      "title": "FastCast logs",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} |= \"FastCast\""
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "Poll",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "Pushes behind their listing by league",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (league) (increase(sportal_push_behind_listing_total[$__rate_interval])) or vector(0)",
          "legendFormat": "{{league}}"
        }
      ],
      "description": "Pushed snapshots behind the game their league lists, which the listing takes anyway (ADR 0014)"
    },
    {
      "id": 41,
      "type": "logs",
      "title": "Provider logs",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} |~ \"EspnProvider|EspnState\""
        }
      ]
    },
    {
      "id": 42,
      "type": "row",
      "title": "Hub",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 1,
          "type": "timeseries",
          "title": "Hub log volume by level",
          "gridPos": {
            "x": 0,
            "y": 78,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "bars",
                "fillOpacity": 80,
                "stacking": {
                  "mode": "normal"
                }
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (detected_level) (count_over_time({service_name=\"sportal-hub\"} [$__interval]))",
              "legendFormat": "{{detected_level}}"
            }
          ]
        },
        {
          "id": 2,
          "type": "logs",
          "title": "Recent warnings and errors",
          "gridPos": {
            "x": 12,
            "y": 78,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "{service_name=\"sportal-hub\"} | detected_level=~\"warn|error|fatal|critical\""
            }
          ]
        }
      ]
    }
  ]
}
