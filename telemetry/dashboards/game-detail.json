{
  "uid": "sportal-game-detail",
  "title": "Game Detail",
  "description": "${game:text}",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "title": "Game Day",
      "type": "link",
      "url": "/d/sportal-game-day/game-day?from=${__from}&to=${__to}&refresh=10s",
      "targetBlank": false
    },
    {
      "title": "Hub operations",
      "type": "link",
      "url": "/d/sportal-hub/hub?from=${__from}&to=${__to}&refresh=10s",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 0,
          "query": "query_result(max by (game, matchup) (sportal_game_state_ratio))",
          "refId": "PrometheusVariableQueryEditor-Game"
        },
        "definition": "query_result(max by (game, matchup) (sportal_game_state_ratio))",
        "regex": "/game=\"(?<value>[^\"]+)\".*matchup=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Listing",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(sportal_game_state_ratio{game=~\"$game\"}) or vector(0)) + 2 * (max(sportal_hub_up_ratio) or vector(0))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Hub unavailable",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Hub unavailable",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "Game no longer listed",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "Listed",
                  "color": "green",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Away",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sportal_game_score_ratio{game=~\"$game\",side=\"away\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Home",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sportal_game_score_ratio{game=~\"$game\",side=\"home\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Status",
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sportal_game_status_ratio{game=~\"$game\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Scheduled",
                  "index": 1
                },
                "2": {
                  "text": "Live",
                  "index": 2
                },
                "3": {
                  "text": "Halftime",
                  "index": 3
                },
                "4": {
                  "text": "Delayed",
                  "index": 4
                },
                "5": {
                  "text": "Final",
                  "index": 5
                },
                "6": {
                  "text": "Postponed",
                  "index": 6
                },
                "7": {
                  "text": "Canceled",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Period",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sportal_game_period_ratio{game=~\"$game\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Clock",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sportal_game_clock_ratio{game=~\"$game\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "clock_s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Updated",
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(sportal_game_updated_at_ratio{game=~\"$game\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 31
              },
              {
                "color": "red",
                "value": 61
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Scoring timeline",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | game=~\"$game\" | play=~\".+\" | scoring=\"true\"",
          "maxLines": 1000
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Full play log",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | game=~\"$game\" | play=~\".+\"",
          "maxLines": 1000
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Diagnostics",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Snapshot age",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 31
              },
              {
                "color": "red",
                "value": 61
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - sportal_game_updated_at_ratio{game=~\"$game\"}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Plays / 15 min",
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"sportal-hub\"} | game=~\"$game\" | play=~\".+\" [15m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Game warnings and errors",
      "description": "An empty panel means no warning or error was attributed to this game. Feed-wide failures are on Hub.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "sortOrder": "Descending",
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | game=~\"$game\" | detected_level=~\"warn|error|fatal|critical\"",
          "maxLines": 1000
        }
      ]
    }
  ]
}
