{
  "uid": "sportal-game",
  "title": "Live games",
  "schemaVersion": 41,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "Hub",
      "type": "link",
      "url": "/d/sportal-hub/hub?${mode:queryparam}&${__url_time_range}",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Events",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "yellow",
        "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" | game=~\"$game\" | event!=\"\"",
        "textFormat": "{{matchup}}: {{event}}"
      },
      {
        "name": "Transitions",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" | game=~\"$game\" |= \"→\""
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(target_info{service_name=\"sportal-hub\"}, sportal_mode)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "description": "Games in the time range, by matchup.",
        "query": {
          "query": "query_result(max by (game, matchup) (max_over_time(sportal_game_state_ratio[$__range]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "refId": "game"
        },
        "regex": "/game=\"(?<value>[^\"]+)\".*matchup=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "sort": 5,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Games",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Games",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every game in the time range. Click a game to show only it below.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (game, league, matchup) (sportal_game_state_ratio * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by (game) (round(increase(sportal_snapshots_total{outcome=\"taken\"}[$__range]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (game) (round(increase(sportal_snapshots_total{outcome=\"behind\"}[$__range]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "sum by (game) (round(increase(sportal_stale_duration_milliseconds_count[$__range]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "sum by (game) (round(increase(sportal_game_events_total[$__range]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "game",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "indexByName": {
              "matchup": 0,
              "league": 1,
              "Value #A": 2,
              "Value #D": 3,
              "Value #E": 4,
              "Value #F": 5,
              "Value #G": 6,
              "game": 7
            },
            "renameByName": {
              "Value #A": "State",
              "Value #D": "Taken",
              "Value #E": "Behind",
              "Value #F": "Stale stretches",
              "Value #G": "Events",
              "matchup": "Matchup",
              "league": "League",
              "game": "Game id"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Show only this game",
              "url": "/d/sportal-game/live-games?${mode:queryparam}&var-game=${__data.fields[\"Game id\"]}&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Stopped",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "Upcoming",
                        "color": "blue",
                        "index": 1
                      },
                      "2": {
                        "text": "Live",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "Stale",
                        "color": "orange",
                        "index": 3
                      },
                      "4": {
                        "text": "Over",
                        "color": "purple",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "row",
      "title": "Selected games",
      "collapsed": false,
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "state-timeline",
      "title": "State",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (matchup) (sportal_game_state_ratio{game=~\"$game\"} * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{matchup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stopped",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "Upcoming",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "Live",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "Stale",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "Over",
                  "color": "purple",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Snapshots taken and behind",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Behind is a snapshot older in game time than the one the fold has: the feed serving a stale copy.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (matchup, outcome) (increase(sportal_snapshots_total{game=~\"$game\"}[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{matchup}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "barchart",
      "title": "Events",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (matchup, event) (round(increase(sportal_game_events_total{game=~\"$game\"}[$__range]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "event",
            "rowField": "matchup",
            "valueField": "Value"
          }
        }
      ],
      "options": {
        "stacking": "normal",
        "xTickLabelRotation": -30
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Stale stretches",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How long a stale game went without a snapshot, recorded when it is taken again. A game goes stale after 90 s.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sportal_stale_duration_milliseconds_bucket{game=~\"$game\"}[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sportal_stale_duration_milliseconds_bucket{game=~\"$game\"}[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"}))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Transitions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Changes of a live game's state, every game together: Live → Stale as games go stale, Stale → Live as they return.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from, to) (increase(sportal_transitions_total[$__rate_interval]) * on (job, instance) group_left target_info{sportal_mode=\"$mode\"})",
          "legendFormat": "{{from}} → {{to}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | sportal_mode=\"$mode\" | game=~\"$game\""
        }
      ],
      "options": {
        "sortOrder": "Descending",
        "showTime": true
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Take traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "query": "{resource.service.name=\"sportal-hub\" && resource.sportal.mode=\"$mode\" && name=\"Slate.take\"}"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      }
    }
  ]
}
