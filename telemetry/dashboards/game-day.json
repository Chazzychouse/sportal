{
  "uid": "sportal-game-day",
  "title": "Game Day",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "title": "Hub operations",
      "type": "link",
      "url": "/d/sportal-hub/hub?from=${__from}&to=${__to}&refresh=10s",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "league",
        "label": "League",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(sportal_game_state_ratio, league)",
          "refId": "PrometheusVariableQueryEditor-League"
        },
        "definition": "label_values(sportal_game_state_ratio, league)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "game",
        "label": "Games with plays",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 0,
          "query": "query_result(max by (game, matchup) (sportal_game_state_ratio{league=~\"$league\"} > 1))",
          "refId": "PrometheusVariableQueryEditor-Game"
        },
        "definition": "query_result(max by (game, matchup) (sportal_game_state_ratio{league=~\"$league\"} > 1))",
        "regex": "/game=\"(?<value>[^\"]+)\".*matchup=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hub",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "2 * (max(sportal_hub_up_ratio) or vector(0)) + (count(sportal_game_state_ratio{league=~\"$league\"}) > bool 0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Hub unavailable",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Hub unavailable",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "No games currently listed",
                  "color": "blue",
                  "index": 2
                },
                "3": {
                  "text": "Games listed",
                  "color": "green",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sportal_game_state_ratio{league=~\"$league\"} == 2) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Upcoming",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sportal_game_state_ratio{league=~\"$league\"} == 1) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Over",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sportal_game_state_ratio{league=~\"$league\"} == 3) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Stalest live update",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max((time() - sportal_game_updated_at_ratio{league=~\"$league\"}) and on(game) (sportal_game_state_ratio{league=~\"$league\"} == 2))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No game live",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 31
              },
              {
                "color": "red",
                "value": 61
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Games",
      "description": "Every game currently listed by the Hub, ordered live, upcoming, then over and by kickoff within each group.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (game, league, matchup) (sportal_game_state_ratio{league=~\"$league\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (game) (sportal_game_status_ratio{league=~\"$league\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (game) (sportal_game_score_ratio{league=~\"$league\",side=\"away\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (game) (sportal_game_score_ratio{league=~\"$league\",side=\"home\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "max by (game) (sportal_game_period_ratio{league=~\"$league\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "max by (game) (sportal_game_clock_ratio{league=~\"$league\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "max by (game) (sportal_game_kickoff_ratio{league=~\"$league\"}) * 1000",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "H",
          "expr": "time() - max by (game) (sportal_game_updated_at_ratio{league=~\"$league\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "expr": "max by (game) ((sportal_game_state_ratio{league=~\"$league\"} == bool 2) + 2 * (sportal_game_state_ratio{league=~\"$league\"} == bool 1) + 3 * (sportal_game_state_ratio{league=~\"$league\"} == bool 3))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "game",
            "mode": "outer"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #I",
                "desc": false
              },
              {
                "field": "Value #G",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time #A": true,
              "Time #B": true,
              "Time #C": true,
              "Time #D": true,
              "Time #E": true,
              "Time #F": true,
              "Time #G": true,
              "Time #H": true,
              "Time #I": true,
              "Value #A": true,
              "Value #I": true
            },
            "indexByName": {
              "matchup": 0,
              "league": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "game": 9
            },
            "renameByName": {
              "matchup": "Matchup",
              "league": "League",
              "Value #B": "Status",
              "Value #C": "Away",
              "Value #D": "Home",
              "Value #E": "Period",
              "Value #F": "Clock",
              "Value #G": "Kickoff",
              "Value #H": "Updated"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Matchup"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open game detail",
                    "url": "/d/sportal-game-detail/game-detail?var-game=${__data.fields[\"game\"]}&from=${__from}&to=${__to}&refresh=10s",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Scheduled",
                        "index": 1
                      },
                      "2": {
                        "text": "Live",
                        "index": 2
                      },
                      "3": {
                        "text": "Halftime",
                        "index": 3
                      },
                      "4": {
                        "text": "Delayed",
                        "index": 4
                      },
                      "5": {
                        "text": "Final",
                        "index": 5
                      },
                      "6": {
                        "text": "Postponed",
                        "index": 6
                      },
                      "7": {
                        "text": "Canceled",
                        "index": 7
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Clock"
            },
            "properties": [
              {
                "id": "unit",
                "value": "clock_s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kickoff"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Updated"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 31
                    },
                    {
                      "color": "red",
                      "value": 61
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "game"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Recent plays by game",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "logs",
      "title": "${game:text}",
      "repeat": "game",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 10
      },
      "description": "Latest five plays in the selected range. No logs means no plays were received in range.",
      "links": [
        {
          "title": "Open game detail",
          "url": "/d/sportal-game-detail/game-detail?var-game=${game}&from=${__from}&to=${__to}&refresh=10s",
          "targetBlank": false
        }
      ],
      "options": {
        "sortOrder": "Descending",
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sportal-hub\"} | game=~\"$game\" | play=~\".+\"",
          "maxLines": 5
        }
      ]
    }
  ]
}
