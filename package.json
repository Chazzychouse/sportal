{
  "name": "sportal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "dev": "pnpm telemetry || echo 'sportal: telemetry is off (is Docker running?)'; pnpm -r --parallel run dev",
    "dev:x11": "SPORTAL_ELECTRON_FLAGS=--ozone-platform=x11 pnpm dev",
    "dev:golden": "SPORTAL_SCENARIO=crowded-fourth-quarter SPORTAL_SCENARIO_SPEED=10 pnpm dev",
    "check": "biome check . && pnpm typecheck && pnpm structure && pnpm test",
    "typecheck": "tsc --noEmit && pnpm -r --parallel exec tsc --noEmit",
    "structure": "depcruise apps packages && knip --no-config-hints && knip --production --no-config-hints",
    "test": "vitest run",
    "format": "biome check --write .",
    "telemetry": "docker compose -f telemetry/compose.yaml up -d",
    "telemetry:down": "docker compose -f telemetry/compose.yaml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/tsgo": "0.50.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "^24",
    "dependency-cruiser": "^18.5.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
