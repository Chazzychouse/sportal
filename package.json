{
  "name": "sportal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "dev": "pnpm -r --parallel run dev",
    "dev:x11": "SPORTAL_ELECTRON_FLAGS=--ozone-platform=x11 pnpm dev",
    "check": "biome check . && pnpm typecheck && pnpm structure && pnpm test",
    "typecheck": "tsc --noEmit && pnpm -r --parallel exec tsc --noEmit",
    "structure": "depcruise apps packages && knip --no-config-hints && knip --production --no-config-hints",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/tsgo": "0.50.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "^24",
    "dependency-cruiser": "^18.5.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "typescript": "7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "vitest": "^5.0.3"
  }
}
