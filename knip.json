{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/*.ts!"],
      "project": ["src/**/*.ts!", "!src/**/Test*.ts!"]
    },
    "apps/hub": {
      "entry": [
        "src/main.ts!",
        "src/corpus/corpus.ts!",
        "src/corpus/worker.ts!",
        "src/provider/espn/EspnArchive.ts!"
      ],
      "project": ["src/**/*.ts!", "!src/**/Test*.ts!"]
    },
    "apps/web": {
      "entry": ["src/main.tsx!", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx,css}!", "!src/**/Test*.ts!"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/main.ts!",
        "src/preload/ShellBridge.ts!",
        "electron.vite.config.ts",
        "WaitForElectron.ts"
      ],
      "project": ["src/**/*.ts!"],
      "ignoreBinaries": ["electron", "electron-vite"]
    }
  },
  "ignoreDependencies": ["@effect/language-service"],
  "ignoreIssues": {
    "apps/web/src/design/**": ["exports", "types"]
  }
}
