{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/*.ts!"],
      "project": ["src/**/*.ts!", "!src/**/Test*.ts!"]
    },
    "apps/hub": {
      "entry": ["src/main.ts!", "src/provider/espn/CutScenario.ts!", "src/provider/espn/ImportRecording.ts!"],
      "project": ["src/**/*.ts!", "!src/**/Test*.ts!"]
    },
    "apps/web": {
      "entry": ["src/main.tsx!", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx,css}!", "!src/**/Test*.ts!"]
    },
    "apps/desktop": {
      "entry": ["src/main/main.ts!", "src/preload/ShellBridge.ts!", "electron.vite.config.ts"],
      "project": ["src/**/*.ts!"],
      "ignoreBinaries": ["electron", "electron-vite"]
    }
  },
  "ignoreIssues": {
    "apps/web/src/design/**": ["exports", "types"]
  }
}
