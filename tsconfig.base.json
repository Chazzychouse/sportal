{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // AGENTS.md: "HTTP lives in `effect/http` and `effect/http-api`". FastCast is ESPN's WebSocket, read through
        // `effect/socket`. The web UI holds what the live stream said in an atom from `effect/reactivity`, and keeps each
        // Display's Screen in the browser through `effect/persistence/KeyValueStore`.
        // The Hub's live queries are stream RPCs from `effect/rpc`, over one WebSocket per page.
        // Effect marks all of these unstable; they are the house choices, not accidents.
        "allowedUnstableApis": [
          "effect/http",
          "effect/http-api",
          "effect/socket",
          "effect/rpc",
          "effect/reactivity",
          "effect/persistence/KeyValueStore"
        ]
      }
    ]
  }
}
