{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // AGENTS.md: "HTTP lives in `effect/http` and `effect/http-api`". The technical spec (2.2) adds Effect SQL for
        // persistence and `effect/observability` for OTLP telemetry; FastCast is ESPN's WebSocket, read through
        // `effect/socket`. The Hub's process test spawns the Hub through Effect's process wrapper, `effect/process`. A SQL
        // row is a `Model.Class` from `effect/schema/Model` (AGENTS.md, "SQL row").
        // The web UI holds what the live stream said in an atom from `effect/reactivity`, and keeps each Display's Screen
        // in the browser through `effect/persistence/KeyValueStore`.
        // Effect marks all of these unstable; they are the house choices, not accidents.
        "allowedUnstableApis": [
          "effect/http",
          "effect/http-api",
          "effect/sql",
          "effect/socket",
          "effect/observability/Otlp",
          "effect/process",
          "effect/schema/Model",
          "effect/reactivity",
          "effect/persistence/KeyValueStore"
        ]
      }
    ]
  }
}
